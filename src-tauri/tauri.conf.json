{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Контекст менеджера",
  "version": "0.1.0",
  "identifier": "app.managerworkspace.local",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Контекст менеджера", "width": 1280, "height": 850, "minWidth": 900, "minHeight": 650 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": { "active": true, "targets": ["app"] }
}
